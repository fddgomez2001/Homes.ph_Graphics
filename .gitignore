# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local test artifacts
/test-results/
/playwright-report/

# desktop app build output (desktop-build/app.env contains secrets)
/dist/
/desktop-build/

# Android app: signing key and passwords (keep a backup — updates need the same key)
/android/release-key/
*.jks
*.keystore

# photo enhancer runtime, copied from node_modules/onnxruntime-web by scripts/copy-ort.mjs
/public/ort/

# installers and app packages (big; built by npm run desktop:dist / the Android build)
*.exe
*.blockmap
*.apk
*.aab

# the team's original Figma / Canva design exports (big): kept on the PC only. The build scripts read them;
# what the app uses is made from them and committed (public/ads, public/brand/templates, public/brand/carousel/collage…)
/public/Pickleplay Templates/
/public/Poster Maker Template/
/public/brand/carousel/Carousel Cover Templates/
/public/ALL-BRAND-TEMPLATES/
