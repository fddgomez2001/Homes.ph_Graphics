# Daily Carousel Maker — environment variables
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local. Placeholders only in this file.

# --- Supabase (Project Settings → API) -------------------------------------
# Safe to expose to the browser: access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# The service-role key is NOT used by this app. Do not add it here.

# --- Posting website ---------------------------------------------------------
# Set to "website" only on the deployment of the posting website (see README):
# every page except /site then leads to /site. Leave empty for the full app.
SITE_MODE=

# --- Cloudinary (Console → Settings → API Keys) -----------------------------
# Server-only. These are never sent to the browser (no NEXT_PUBLIC_ prefix).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: a *signed* upload preset with extra restrictions (formats, size).
CLOUDINARY_UPLOAD_PRESET=
# Optional: Cloudinary folder for uploads (default: homes-ph-carousel)
CLOUDINARY_FOLDER=homes-ph-carousel

# --- AI suggestions (Groq, console.groq.com → API Keys) ----------------------
# Server-only. Used for the description / subtitle / caption suggestions.
GROQ_API_KEY=
# Optional: model override (default: openai/gpt-oss-120b)
GROQ_MODEL=
