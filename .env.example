# Daily Carousel Maker — environment variables
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local. Placeholders only in this file.

# --- Supabase (Project Settings → API) -------------------------------------
# Safe to expose to the browser: access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# The service-role key is NOT used by this app. Do not add it here.

# --- Posting website ---------------------------------------------------------
# Set to "website" only on the deployment of the posting website (see README):
# every page except /site then leads to /site. Leave empty for the full app.
SITE_MODE=

# --- Cloudinary (Console → Settings → API Keys) -----------------------------
# Server-only. These are never sent to the browser (no NEXT_PUBLIC_ prefix).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: a *signed* upload preset with extra restrictions (formats, size).
CLOUDINARY_UPLOAD_PRESET=
# Optional: Cloudinary folder for uploads (default: homes-ph-carousel)
CLOUDINARY_FOLDER=homes-ph-carousel

# --- AI suggestions (Groq, console.groq.com → API Keys) ----------------------
# Server-only. Used for the description / subtitle / caption suggestions.
GROQ_API_KEY=
# Optional: model override (default: openai/gpt-oss-120b)
GROQ_MODEL=

# --- Web search (Tavily, app.tavily.com → API Keys; free 1,000 credits a month) ---
# Server-only, optional. Trending news and Search a topic use it; without it Groq's web search is used.
TAVILY_API_KEY=

# --- Google results (SerpApi, serpapi.com → API Key; free 250 searches a month) ---
# Server-only, optional. Trending news: Google News, and the public Facebook posts Google has indexed.
SERPAPI_API_KEY=

# --- Facebook Pages (Meta Graph API) ------------------------------------------
# Server-only, optional. Trending news → "Facebook Pages to read": a Page access token (reads the Pages it
# manages; other Pages need Meta's Page Public Content Access).
META_ACCESS_TOKEN=
